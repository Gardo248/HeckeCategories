#############################################################
# FreeBSCategory.gd -- DECLARATIONS
#
# The CAP category FreeBSCategory( W ), built as a
# reinterpretation of the syntactic category Syn
# (SyntacticCategoryInDoctrines, ToolsForCategoricalTowers).
# The combinatorics of words (inversion sets, normal forms,
# subexpressions, DoubleLeavesIndicesOfHom) and its conventions
# are in coxeter.gd.
#
# Loaded with FreeBSCategory.g (packages + coxeter.g + these files).
# ALL the arithmetic is exact (integers and cyclotomic numbers).
#
# Objects:   words x (datum: the list x, attribute BSUnderlyingWord).
# Morphisms: generated under composition and tensor product by the
#            generating morphisms, identified by a
#            label; source and target fix the direction:
#              [ "Dot", s ]             : [s] -> []  (end dot),
#                                         [] -> [s]  (start dot);
#              [ "TrivalentVertex", s ] : [s,s] -> [s] (merge),
#                                         [s] -> [s,s] (split);
#              [ "Spider", s, t ]       : [s,t,s,...] -> [t,s,t,...]
#                                         (both of length m_st), for
#                                         s <> t and m_st <> infinity.
#            Datum (attribute BSLayers): the list of "layers"
#                [ p, x, y, label ]
#            in composition order; the layer acts as
#            id_(p letters on the left) (x) gen(x -> y, label) (x) id_(rest).
#            The empty list is the identity.
#            The datum is stored AS IT COMES (lazy normalization):
#            two equal morphisms may have different BSLayers.
#            The CANONICAL FORM (attribute BSCanonicalLayers, computed
#            only when needed, i.e. when comparing) is the lexicographic
#            minimum in the class generated by the interchange law
#            between adjacent independent layers. Two morphisms are
#            equal in the free strict monoidal category if and only
#            if they have the same canonical form (Joyal-Street;
#            Delpeuch-Vicary, "Normalization for planar string
#            diagrams", 2018).
# No Soergel relation is imposed (free category).
#############################################################

DeclareCategory( "IsFreeBSCategory", IsCapCategory );
DeclareCategory( "IsCellInFreeBSCategory", IsCapCategoryCell );
DeclareCategory( "IsObjectInFreeBSCategory",
                 IsCellInFreeBSCategory and IsCapCategoryObject );
DeclareCategory( "IsMorphismInFreeBSCategory",
                 IsCellInFreeBSCategory and IsCapCategoryMorphism );

DeclareAttribute( "UnderlyingCoxeterGroup", IsFreeBSCategory );
DeclareAttribute( "BSUnderlyingWord", IsObjectInFreeBSCategory );
DeclareAttribute( "BSLayers", IsMorphismInFreeBSCategory );
# Canonical form of BSLayers
DeclareAttribute( "BSCanonicalLayers", IsMorphismInFreeBSCategory );

# Constructor of the category
DeclareAttribute( "FreeBSCategory", IsCoxeterGroup );

# The object corresponding to the word x
DeclareOperation( "BSObject", [ IsFreeBSCategory, IsList ] );

# The generating morphism x -> y with the given label (see above)
DeclareOperation( "BSGeneratingMorphism",
                  [ IsFreeBSCategory, IsList, IsList, IsList ] );

# Dots of colour s: UpperDot [] -> [s], LowerDot [s] -> []
DeclareOperation( "UpperDot", [ IsFreeBSCategory, IsPosInt ] );
DeclareOperation( "LowerDot", [ IsFreeBSCategory, IsPosInt ] );

# Trivalent vertices of colour s: [s] -> [s,s] and [s,s] -> [s]
DeclareOperation( "SplitVertex", [ IsFreeBSCategory, IsPosInt ] );
DeclareOperation( "MergeVertex", [ IsFreeBSCategory, IsPosInt ] );

# The 2m_st-valent vertex [s,t,s,...] -> [t,s,t,...]
DeclareOperation( "SpiderMorphism", [ IsFreeBSCategory, IsPosInt, IsPosInt ] );

# All the generating morphisms: for each s UpperDot, LowerDot,
# SplitVertex, MergeVertex; then SpiderMorphism( s, t ) for the
# ordered pairs s <> t with m_st <> infinity
DeclareAttribute( "BSGeneratingMorphisms", IsFreeBSCategory );

# Canonical form of a list of layers (see above)
DeclareGlobalFunction( "FreeBSCanonicalLayers" );
