#############################################################
# coxeter.gd -- DECLARATIONS
#############################################################

DeclareCategory("IsCoxeterGroup", IsGroup);

DeclareAttribute("CoxeterMatrix", IsGroup);
DeclareAttribute("CoxeterGeneratorNames", IsGroup);

# Faithful homomorphism W -> matrix group generated by the reflections
# (Tits geometric representation). Holds for every Coxeter group.
DeclareAttribute("CoxeterReflectionRepresentation", IsCoxeterGroup);

# Faithful homomorphism W -> permutation group on the roots.
# Exists only if the group is finite.
DeclareAttribute("CoxeterPermutationRepresentation", IsCoxeterGroup);

# Constructors. The matrix is IsList and not IsMatrix: with
# `infinity` entries the filter IsMatrix might not be satisfied.
DeclareOperation("CoxeterGroupByMatrix", [IsList]);
DeclareOperation("CoxeterGroupByMatrix", [IsList, IsList]);

# Coxeter bilinear form (exact) and matrices of the simple
# reflections in the geometric representation: computed only
# once per group (immutable values).
DeclareAttribute("CoxeterBilinearForm", IsCoxeterGroup);
DeclareAttribute("CoxeterReflectionMatrices", IsCoxeterGroup);

# Functions working on the Coxeter matrix M alone
DeclareGlobalFunction("IsFiniteCoxeterMatrix");

#############################################################
# Combinatorics of words (inversion sets, normal forms,
# subexpressions)
#
# ALL the arithmetic is exact (integers and cyclotomic numbers).
#
# Conventions
#   - a word x is a list of generator indices, e.g. [1,2,1];
#   - a subexpression e of x is a 0/1 list of the same length;
#   - the endpoint of e is s_{x_1}^{e_1} ... s_{x_n}^{e_n};
#   - an element w of W is represented by its normal form.
#############################################################

# Inversion set I(w) (sorted list of vectors in the basis of
# simple roots). It determines w uniquely.
DeclareOperation( "InversionSetOfCoxeterWord",
                  [ IsCoxeterGroup, IsList ] );

# Inversion set of w*s_i, given that of w.
DeclareOperation( "InversionSetAfterRightMultiplication",
                  [ IsCoxeterGroup, IsList, IsPosInt ] );

# Normal form of the element with the given inversion set.
DeclareOperation( "CoxeterNormalFormOfInversionSet",
                  [ IsCoxeterGroup, IsList ] );

# Normal form of an arbitrary word.
DeclareOperation( "CoxeterNormalFormOfWord",
                  [ IsCoxeterGroup, IsList ] );

# All the subexpressions of x: list of pairs [ e, w ].
DeclareOperation( "SubexpressionsOfCoxeterWord",
                  [ IsCoxeterGroup, IsList ] );

# Subexpressions of x grouped by endpoint: record
# rec( endpoints, fibers ), where endpoints is the sorted list
# (without repetitions) of the endpoints w (in normal form) and
# fibers[j] is the list of the subexpressions e (0/1 lists) ending
# in endpoints[j], in the same order as they appear in
# SubexpressionsOfCoxeterWord.
DeclareOperation( "SubexpressionsOfCoxeterWordByEndpoint",
                  [ IsCoxeterGroup, IsList ] );

# Indices of the double leaves of Hom(x,y): sorted list of the
# triples [ e, f, w ], with e, f subexpressions of x, y with the
# same endpoint w.
DeclareOperation( "DoubleLeavesIndicesOfHom",
                  [ IsCoxeterGroup, IsList, IsList ] );
